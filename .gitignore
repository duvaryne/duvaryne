.DS_Store

# macOS/iCloud duplicate artefacts. This machine produces "name 2.ext" copies during
# sync, and a blanket `git add -A` will happily commit them — 20 of them reached the
# repo once, including a second copy of the 2.8MB WordPress export and stale duplicates
# of every lib/*.ts that then drift from the originals.
*\ [0-9].*
*\ copy.*
*\ copy\ [0-9].*
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel
.idea/
.vscode/
coverage/
.lighthouseci/

# Cloudflare / OpenNext
.open-next/
.wrangler/
cloudflare-env.d.ts

# Neon CLI workspace context
.neon

# Local editor/assistant tooling. These are per-developer scratch: the skills are
# installed by `npx skills add` and pinned in a lockfile that means nothing to anyone
# else's machine, and AGENTS.md/CLAUDE.md are re-generated by `next dev` on every run
# (node_modules/next/dist/server/lib/generate-agent-files.js), so committing them just
# produces a permanently dirty tree.
.agents/
.claude/
skills-lock.json
AGENTS.md
CLAUDE.md

# Wrangler local secrets
.dev.vars
.dev.vars.*
