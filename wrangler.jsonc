{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duvaryne",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",

  // nodejs_compat is required by the OpenNext worker shim.
  // global_fetch_strictly_public makes fetch() to our own domain leave the worker and
  // come back through the edge, which is what Next's own data fetching expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Custom domains declared here rather than clicked in the dashboard, so the routing is
  // reviewable and reproducible. Cloudflare creates the proxied DNS records and issues the
  // certificate for each. Both hosts are served by the same Worker; canonicals and the
  // sitemap always point at the apex, so www does not compete for indexing.
  "routes": [
    { "pattern": "duvaryne.com", "custom_domain": true },
    { "pattern": "www.duvaryne.com", "custom_domain": true }
  ],

  // Secrets (DATABASE_URL, TURNSTILE_SECRET_KEY, RESEND_API_KEY) are NOT set here —
  // they go in via `wrangler secret put`, so they never reach the repository.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://duvaryne.com"
  }
}
