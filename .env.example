# Copy to .env.local for local work. Never commit .env.local.
#
# In production these are Cloudflare Worker secrets, set with `wrangler secret put NAME`.
# Only NEXT_PUBLIC_SITE_URL lives in wrangler.jsonc, because it is not secret and the
# build inlines it.

# ── Site ─────────────────────────────────────────────────────────────────────

# Apex, no www, no trailing slash. Drives canonicals, JSON-LD, sitemap and robots.
# robots.ts only allows indexing when this contains "duvaryne.com", so preview
# deployments are noindex automatically.
NEXT_PUBLIC_SITE_URL=https://duvaryne.com

# ── Neon (Lakebase Postgres) ─────────────────────────────────────────────────
#
# DO NOT hand-write these. Run `neon link` (once) or `neon env pull` and the CLI
# writes them into .env.local from the linked branch. Project and branch IDs live
# in the git-ignored .neon file; services are declared in neon.ts.
#
#   npm i -g neon
#   neon link --org-id org-frosty-surf-08952346 --project-id curly-mud-99483022 -y
#
# DATABASE_URL           pooled (-pooler host). Application traffic — this is what the
#                        Worker uses. PgBouncer transaction mode.
# DATABASE_URL_UNPOOLED  direct. Schema migrations, dumps, logical replication, and
#                        anything needing session state. `pnpm db:init` prefers this.
#
# Create the table once with:  pnpm db:init
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth is provisioned on the project (declared in neon.ts) but this site does not
# use it. These are pulled by the CLI; nothing reads them.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=

# ── Cloudflare Turnstile — spam protection on the contact form ───────────────
# https://dash.cloudflare.com -> Turnstile -> Add site
# If TURNSTILE_SECRET_KEY is unset the check is skipped, so the form stays testable
# in preview. Production must set it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Resend — enquiry notification email (optional) ───────────────────────────
#
# Optional by design. Enquiries are already durable in Neon before this is called,
# so a missing or failing key logs a warning and never fails the submission.
#
# NOTIFY_FROM must be on a domain verified in Resend. Verifying a SUBDOMAIN
# (e.g. send.duvaryne.com) avoids touching the apex MX/SPF records that the
# existing GoDaddy mailbox depends on.
RESEND_API_KEY=
NOTIFY_FROM=noreply@send.duvaryne.com
NOTIFY_TO=hello@duvaryne.com

# ── Preview only ─────────────────────────────────────────────────────────────
# Renders content marked `draft: true`. Leave UNSET in production. See lib/phase.ts.
# NEXT_PUBLIC_INCLUDE_DRAFTS=true
