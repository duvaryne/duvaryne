# Copy to .env.local for local work. Never commit .env.local.
# In Vercel these are set per-environment under Settings -> Environment Variables.

# ── Required in Production ───────────────────────────────────────────────────

# Apex, no www, no trailing slash. Drives canonicals, JSON-LD, sitemap and robots.
# robots.ts only allows indexing when this contains "duvaryne.com", so preview
# deployments are automatically noindex.
NEXT_PUBLIC_SITE_URL=https://duvaryne.com

# ── Titan SMTP — delivers contact-form submissions ──────────────────────────
#
# Sending through Titan rather than a third-party relay means the existing apex SPF
# record (`v=spf1 include:secureserver.net -all`) already authorises us. The contact
# form therefore needs NO DNS CHANGE AT ALL — nothing to add, nothing to merge, and
# no risk to the records Titan and the outreach agents depend on.
#
# Two candidate host sets exist and BOTH answer on 465 and 587. Only an authenticated
# login proves which one owns the mailbox, so run `pnpm mail:verify` before deploying:
#
#   A (GoDaddy, default)  smtpout.secureserver.net  465 SSL / 587 STARTTLS
#   B (Titan-native)      smtp.titan.email          465 SSL / 587 STARTTLS
#
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Defaults to true when port is 465, false otherwise. Only set to override.
# SMTP_SECURE=true

# The mailbox itself. This is a SECRET — set it in Vercel, never commit it.
# The mailbox needs third-party app access ENABLED and 2FA DISABLED, or Titan
# refuses SMTP client connections. See docs/DEPLOYMENT.md Step 4.
SMTP_USER=hello@duvaryne.com
SMTP_PASSWORD=

# Where submissions land. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=hello@duvaryne.com

# Who they are sent AS. Defaults to SMTP_USER — Titan rejects a From that is not the
# authenticated mailbox, so only change this if the mailbox is authorised to send as it.
# CONTACT_FROM_EMAIL=hello@duvaryne.com

# Cloudflare Turnstile — spam protection on the contact form.
# https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Preview only ─────────────────────────────────────────────────────────────

# Renders draft content: the 10 case studies, /blog, /products, /engagement-models.
# Set to "true" for the Preview environment ONLY. Leave UNSET in Production —
# that is the Wave 0 + Phase 1 gate. See lib/phase.ts.
# NEXT_PUBLIC_INCLUDE_DRAFTS=true
