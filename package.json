{
  "name": "duvaryne",
  "version": "1.0.0",
  "private": true,
  "description": "duvaryne.com — AWS cloud & DevOps consulting, Bengaluru",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "content:validate": "tsx scripts/validate-content.ts",
    "cf:build": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare populateCache local && wrangler dev",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare populateCache remote && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:init": "tsx scripts/db-init.ts"
  },
  "dependencies": {
    "@neon/config": "^1.0.5",
    "@neondatabase/serverless": "^1.1.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "1.29.2",
    "@shikijs/themes": "^4.4.3",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}